# ─────────────────────────────────────────────────────────────
# Variables de entorno — Alternadores y Arrancadores Río Segundo
# Copia este archivo como `.env.local` y completa los valores.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (usada en SEO, sitemap y Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.alternadoresyarrancadoresrio2.com

# ── Formulario de contacto ──
# Opción A: Envío de correo por SMTP (recomendado para producción)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO_EMAIL=tallerelectrico.rio2@hotmail.com

# Opción B: Servicio externo (Resend / Formspree / EmailJS)
# RESEND_API_KEY=

# ── Analítica (opcional) ──
NEXT_PUBLIC_GA_ID=
